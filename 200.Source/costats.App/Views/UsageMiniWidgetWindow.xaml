<Window x:Class="costats.App.Views.UsageMiniWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:costats.App"
        xmlns:loc="clr-namespace:Jhj.Core.Wpf.Localization;assembly=Jhj.Core.Wpf"
        Title="JHJ AI Usage Monitor"
        Width="312"
        SizeToContent="Height"
        FontFamily="Pretendard Variable, Pretendard, Malgun Gothic, Segoe UI"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent">
    <!-- 계약: 미니 위젯 — 사용률 막대만 작게 늘 띄워 두는 창. 고정(📌)이면 항상 위, 끌어 놓은 자리는 설정에 저장된다. 값은 PulseViewModel 의 카드(ProviderPulseViewModel)를 그대로 쓴다 -->
    <!-- 왜: 폭은 토스트와 같은 312 이고 막대는 한 줄에 최대 세 칸(세션 · 주간 · 모델별)이다 — 한 계정이 토스트 한 장 높이에 들어가야 한다(2026-10-12 사용자 지정) -->
    <Window.Resources>
        <DataTemplate x:Key="BarCell">
            <!-- DataContext: MiniBar -->
            <StackPanel Margin="0,2,8,2">
                <DockPanel>
                    <TextBlock Text="{Binding Percent}" DockPanel.Dock="Right" FontSize="12" FontWeight="Bold"
                               Foreground="{Binding Color, Converter={x:Static local:HexToBrushConverter.Instance}}" />
                    <Path Style="{StaticResource QuotaIcon}" Width="11" Height="11" Margin="0,0,3,1" VerticalAlignment="Bottom"
                          Data="{Binding Kind, Converter={x:Static local:QuotaKindIconConverter.Instance}}" />
                    <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                </DockPanel>
                <Grid Height="5" Margin="0,2,0,2">
                    <Rectangle RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource DividerBrush}" />
                    <Rectangle RadiusX="2.5" RadiusY="2.5" HorizontalAlignment="Left"
                               Fill="{Binding Color, Converter={x:Static local:HexToBrushConverter.Instance}}">
                        <Rectangle.Width>
                            <MultiBinding Converter="{x:Static local:ProgressWidthConverter.Instance}">
                                <Binding Path="Progress" />
                                <Binding Path="Maximum" />
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                            </MultiBinding>
                        </Rectangle.Width>
                    </Rectangle>
                </Grid>
                <TextBlock Text="{Binding Reset}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ResetAt}" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <!-- 계약: 창을 누른 뒤 F5 — 팝업과 같은 새로고침 -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>
    <Border CornerRadius="10" BorderThickness="1" Padding="10,6,6,6"
            Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource WindowBorderBrush}">
        <StackPanel>
            <!-- 머리: 끌기 자리 · 계정 선택 · 갱신 시각 · 고정 · 닫기 -->
            <DockPanel MouseLeftButtonDown="OnHeaderDrag" Background="Transparent">
                <Button Content="✕" DockPanel.Dock="Right" Width="22" Height="20" Padding="0" FontSize="12" Cursor="Hand" Click="OnCloseClick"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}" ToolTip="{loc:Tr 'Hide mini widget'}" />
                <ToggleButton x:Name="PinButton" Style="{StaticResource PinToggle}" DockPanel.Dock="Right" Click="OnPinClick" ToolTip="{loc:Tr 'Pin (always on top)'}" />
                <!-- 왜: 팝업의 새로고침과 같은 단추다 — 갱신 중에는 강조색 회전 표시로 바뀐다(App.xaml SpinnerPath). DataContext 는 PulseViewModel -->
                <Button DockPanel.Dock="Right" Width="22" Height="20" Padding="0" Cursor="Hand"
                        Command="{Binding RefreshCommand}" ToolTip="{loc:Tr 'Refresh now'}"
                        IsEnabled="{Binding IsRefreshing, Converter={x:Static local:BoolNegationConverter.Instance}}">
                    <!-- 왜: 기본 Button 템플릿은 비활성(갱신 중)일 때 밝은 바탕을 깐다 — 테마 바탕 그대로, 갱신 중에는 회전 표시만 바뀐다 -->
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" Background="Transparent" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                              Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="13" Height="13"
                              Visibility="{Binding IsRefreshing, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}" />
                        <Path Style="{StaticResource SpinnerPath}" Width="13" Height="13"
                              Visibility="{Binding IsRefreshing, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                            <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                        </Path>
                    </Grid>
                </Button>
                <TextBlock Text="{Binding Footer, RelativeSource={RelativeSource AncestorType=Window}}" DockPanel.Dock="Right" Margin="0,0,6,0"
                           FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                <ComboBox x:Name="AccountBox" ItemsSource="{Binding Accounts, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding SelectedAccount, RelativeSource={RelativeSource AncestorType=Window}}"
                          Style="{StaticResource SettingsComboBox}" FontSize="11" MinWidth="130" HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Cards, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- DataContext: MiniCard -->
                        <StackPanel Margin="0,0,0,2">
                            <Border Height="1" Margin="0,2,8,5" Background="{DynamicResource DividerBrush}"
                                    Visibility="{Binding ShowDivider, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       Visibility="{Binding ShowName, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                            <ItemsControl ItemsSource="{Binding Bars}" ItemTemplate="{StaticResource BarCell}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
