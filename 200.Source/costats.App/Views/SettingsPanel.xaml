<UserControl x:Class="costats.App.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:costats.App"
             xmlns:loc="clr-namespace:costats.App.Localization"
             FontFamily="Pretendard Variable, Pretendard, Malgun Gothic, Segoe UI">

    <UserControl.Resources>
        <!-- Light color palette with WCAG AA contrast -->
        <!-- 색 브러시는 App 리소스(Themes/Bull.*.xaml)에서 온다 -->

        <!-- ComboBox Style -->
        <!-- 함정: 기본 ComboBox 템플릿은 배경이 밝은 색으로 고정이라 Background 만 바꿔서는 다크가 안 된다 — 템플릿을 통째로 갈아야 한다 -->
        <Style x:Key="SettingsComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="10,6" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" Background="{DynamicResource SubtleOverlayBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6">
                                            <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,7,26,7" VerticalAlignment="Center" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 계약: 입력도 되고 추천 목록도 고를 수 있는 콤보 — PART_EditableTextBox 가 있어야 IsEditable 이 동작한다 -->
        <Style x:Key="SettingsEditableCombo" TargetType="ComboBox" BasedOn="{StaticResource SettingsComboBox}">
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" Background="{DynamicResource BgBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4">
                                            <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBox x:Name="PART_EditableTextBox" Margin="2,0,22,0" Padding="4,4" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     FontSize="{TemplateBinding FontSize}" VerticalContentAlignment="Center" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- 왜: 기본 TabControl 은 밝은 바탕·입체 탭이라 테마와 어긋난다 — 머리글은 밑줄형, 본문은 Panel 색 카드로 다시 그린다 -->
        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Head" Padding="4,7" Margin="0,0,2,0" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Background="Transparent" CornerRadius="6,6,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Head" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <!-- 함정: TabItem.IsMouseOver 는 본문 위에서도 켜진다 — 본문을 만지는 동안 선택 탭만 상자로 칠해져 위아래 탭이 달라 보였다 -->
                            <Trigger SourceName="Head" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Head" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTabControl" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                <!-- 함정: TabPanel 은 머리글 합이 폭을 넘으면 두 줄로 접는다(영어에서 발생) — 한 줄 균등 배치로 고정한다 -->
                                <UniformGrid IsItemsHost="True" Rows="1" Margin="0,0,0,-1" />
                            </Border>
                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1,0,1,1" CornerRadius="0,0,10,10" Padding="12,12,12,12">
                                <ContentPresenter ContentSource="SelectedContent" VerticalAlignment="Top" />
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 왜: 바깥 탭 카드 안에 또 카드를 그리면 테두리가 겹친다 — 하위 탭은 밑줄 머리글만 두고 본문은 바탕 그대로 쓴다 -->
        <Style x:Key="SettingsSubTabControl" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                <UniformGrid IsItemsHost="True" Rows="1" Margin="0,0,0,-1" />
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent" VerticalAlignment="Top" Margin="0,10,0,0" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckBorder" Width="20" Height="20" CornerRadius="4"
                                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M3,7 L7,11 L13,3" Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="2"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="12" Height="10" Stretch="Uniform" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SubtleOverlayBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 계약: 계정 한 줄 — 위는 명칭·유형(「편집」을 눌러야 칸이 열린다), 아래는 실제 로그인 계정과 버튼. 이 PC 로그인 줄에는 삭제가 없다 -->
        <!-- 계약: 줄 순서 = 팝업 칩·카드 순서. ⠿ 를 끌어 다른 줄에 놓거나 ▲▼ 로 옮긴다(같은 도구 줄끼리) -->
        <DataTemplate x:Key="AccountRowTemplate">
            <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="6" Background="{DynamicResource SubtleOverlayBrush}"
                    AllowDrop="True" DragOver="OnAccountRowDragOver" Drop="OnAccountRowDrop">
                <StackPanel>
                    <DockPanel Visibility="{Binding IsEditing, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}">
                        <TextBlock Text="⠿" DockPanel.Dock="Left" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Cursor="SizeAll"
                                   Background="Transparent" Foreground="{DynamicResource TextFaintBrush}" ToolTip="{loc:Tr 'Drag to change the order'}"
                                   PreviewMouseLeftButtonDown="OnAccountDragHandleDown" MouseMove="OnAccountDragHandleMove" />
                        <Button Content="{loc:Tr 'Edit'}" DockPanel.Dock="Right" Padding="8,3" FontSize="11" Margin="6,0,0,0"
                                Style="{StaticResource SettingsButton}" Command="{Binding BeginEditCommand}" />
                        <Button Content="▼" DockPanel.Dock="Right" Padding="6,3" FontSize="9" Margin="2,0,0,0"
                                Style="{StaticResource SettingsButton}" CommandParameter="{Binding}" IsEnabled="{Binding CanMoveDown}"
                                Command="{Binding DataContext.MoveRowDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="{loc:Tr 'Move down'}" />
                        <Button Content="▲" DockPanel.Dock="Right" Padding="6,3" FontSize="9" Margin="6,0,0,0"
                                Style="{StaticResource SettingsButton}" CommandParameter="{Binding}" IsEnabled="{Binding CanMoveUp}"
                                Command="{Binding DataContext.MoveRowUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="{loc:Tr 'Move up'}" />
                        <Border DockPanel.Dock="Right" Padding="6,1" CornerRadius="8" VerticalAlignment="Center" Margin="6,0,0,0"
                                BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}"
                                Visibility="{Binding HasType, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding AccountType}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>
                        <TextBlock Text="{Binding DisplayNameText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"
                                   ToolTip="{loc:Tr 'Account name shown in the popup'}" />
                    </DockPanel>
                    <DockPanel Visibility="{Binding IsEditing, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                        <ComboBox DockPanel.Dock="Right" Width="96" Margin="6,0,0,0" Style="{StaticResource SettingsEditableCombo}"
                                  ItemsSource="{Binding DataContext.TypeSuggestions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding AccountType, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{loc:Tr 'Account type — type freely or pick one. Default is shown first when the popup opens.'}" />
                        <TextBox Text="{Binding DisplayNameText, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4"
                                 MaxLength="{Binding MaxNameLength}" IsVisibleChanged="OnNameBoxVisibleChanged"
                                 VerticalContentAlignment="Center" ToolTip="{loc:Tr 'Account name shown in the popup (up to 8 characters)'}"
                                 Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource DividerBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                    <DockPanel Margin="0,5,0,0" Visibility="{Binding IsEditing, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                        <Button Content="{loc:Tr 'Save'}" DockPanel.Dock="Right" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                Style="{StaticResource SettingsButton}" Command="{Binding SaveEditCommand}" />
                        <Button Content="{loc:Tr 'Cancel'}" DockPanel.Dock="Right" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                Style="{StaticResource SettingsButton}" Command="{Binding CancelEditCommand}" />
                        <TextBlock Text="{Binding AccountText}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFaintBrush}" />
                    </DockPanel>
                    <DockPanel Margin="0,5,0,0" Visibility="{Binding IsEditing, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}">
                        <Button Content="{loc:Tr 'Remove'}" DockPanel.Dock="Right" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                Style="{StaticResource SettingsButton}" CommandParameter="{Binding}"
                                Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding IsMain, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}" />
                        <Button Content="{loc:Tr 'Link'}" DockPanel.Dock="Right" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                Style="{StaticResource SettingsButton}" CommandParameter="{Binding}"
                                Command="{Binding DataContext.SignInRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding IsSignedIn, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}"
                                ToolTip="{loc:Tr 'Link an account to this slot — sign in in the browser.'}" />
                        <Button Content="{loc:Tr 'Relink'}" DockPanel.Dock="Right" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                Style="{StaticResource SettingsButton}" CommandParameter="{Binding}"
                                Command="{Binding DataContext.SignInRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding IsSignedIn, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                ToolTip="{loc:Tr 'Wrong account? Sign in again and pick another one (the login window lets you pick any account).'}" />
                        <Button Content="{loc:Tr 'Unlink'}" DockPanel.Dock="Right" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                Style="{StaticResource SettingsButton}" CommandParameter="{Binding}"
                                Command="{Binding DataContext.SignOutRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding IsSignedIn, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                        <TextBlock Text="{Binding AccountText}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFaintBrush}" ToolTip="{Binding ConfigDir}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 계약: 팝업 창 안(제목 줄 아래 ~ 하단 줄 위)에 끼워 쓰는 설정 화면이다 — 머리글과 닫기는 팝업 제목 줄의 「설정 ✕」가 맡는다 -->
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->

            <!-- Divider -->

            <!-- 왜: 앱 자체 설정(일반·화면)과 도구별 설정(계정 · AI 도구)을 위아래로 나눈다 — 계정은 Agent 마다, AI 도구는 연동 대상마다 하위 탭을 둔다 -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.Resources>
                        <Style x:Key="RowLabel" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{loc:Tr 'App settings'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,6" />
                <TabControl Grid.Row="1" Style="{StaticResource SettingsTabControl}" Margin="0,0,0,14">
                <!-- General -->
                <TabItem Header="{loc:Tr 'General'}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding StartAtLogin}" Style="{StaticResource SettingsCheckBox}" Margin="0,0,0,10"
                                  ToolTip="{loc:Tr 'Automatically launch AI Usage Monitor when Windows starts.'}">
                            <TextBlock Text="{loc:Tr 'Start at login'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding PinTrayIcon}" Style="{StaticResource SettingsCheckBox}" Margin="0,0,0,10"
                                  ToolTip="{loc:Tr 'Keep the icon on the taskbar instead of the hidden icons (^), so one click opens the popup.'}">
                            <TextBlock Text="{loc:Tr 'Always show icon on taskbar'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding RefreshOnOpen}" Style="{StaticResource SettingsCheckBox}" Margin="0,0,0,10"
                                  ToolTip="{loc:Tr 'Fetch usage again every time the popup opens. Off: only the background interval refreshes.'}">
                            <TextBlock Text="{loc:Tr 'Refresh when opened'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </CheckBox>
                        <DockPanel ToolTip="{loc:Tr 'How often AI Usage Monitor polls for usage data in the background.'}">
                            <ComboBox ItemsSource="{Binding RefreshOptions}"
                                      SelectedItem="{Binding SelectedRefreshOption}"
                                      Style="{StaticResource SettingsComboBox}"
                                      DockPanel.Dock="Right" HorizontalAlignment="Right" Width="96">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{loc:Tr 'Refresh interval'}" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                        <!-- 계약: 줄마다 상태가 둘이다 — 입력 중(저장 · 삭제)에만 키를 받고, 완료(변경 · 삭제)에서는 입력란이 잠긴다. 규칙은 Services/HotkeyRules.cs -->
                        <ItemsControl ItemsSource="{Binding HotkeySlots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,10,0,0">
                                        <DockPanel>
                                            <!-- 계약: 둘째 버튼 — 2번 줄부터 「삭제」, 1번 줄은 입력 중 「기본」 · 완료 「+」(줄 추가) -->
                                            <Button Content="{Binding SecondaryText}" DockPanel.Dock="Right" Width="40" Padding="0,4" FontSize="11" Margin="6,0,0,0"
                                                    Style="{StaticResource SettingsButton}" Command="{Binding SecondaryCommand}" />
                                            <Button Content="{Binding PrimaryText}" DockPanel.Dock="Right" Width="40" Padding="0,4" FontSize="11" Margin="6,0,0,0"
                                                    Style="{StaticResource SettingsButton}" Command="{Binding PrimaryCommand}" />
                                            <TextBox DockPanel.Dock="Right" Width="116" FontSize="12" Padding="6,4" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                     Text="{Binding Text, Mode=OneWay}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                     InputMethod.IsInputMethodEnabled="False" Loaded="OnHotkeyBoxLoaded"
                                                     IsEnabled="{Binding IsEditing}" IsEnabledChanged="OnHotkeyBoxEnabledChanged"
                                                     ToolTip="{loc:Tr 'Click the box, then press the keys together.'}"
                                                     PreviewKeyDown="OnHotkeyBoxKeyDown" PreviewKeyUp="OnHotkeyBoxKeyUp" GotKeyboardFocus="OnHotkeyBoxFocus" LostKeyboardFocus="OnHotkeyBoxBlur"
                                                     IsVisibleChanged="OnHotkeyBoxVisibleChanged"
                                                     Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="{DynamicResource DividerBrush}" />
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource RowLabel}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding Message, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="Caution">
                                                            <Setter Property="Foreground" Value="{DynamicResource SessionTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="Blocked">
                                                            <Setter Property="Foreground" Value="{DynamicResource WeeklyTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:Tr 'Ctrl+Alt+F1–F12 is recommended. Blocked: one-modifier keys (Ctrl+C, Alt+F4), Win combinations, and Esc·Tab·Delete·arrow keys.'}"
                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                        <DockPanel Margin="0,10,0,0">
                            <Button Content="{loc:Tr 'Check for updates'}" DockPanel.Dock="Right" Padding="10,4" FontSize="11"
                                    Style="{StaticResource SettingsButton}" Command="{Binding CheckForUpdatesCommand}" />
                            <TextBlock Style="{StaticResource RowLabel}">
                                <Run Text="{loc:Tr 'Current'}" /><Run Text="{Binding Version, StringFormat=' v{0}', Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </DockPanel>
                        <!-- 계약: GitHub 최신 릴리스와 지금 버전을 나란히 보인다 — 개발 빌드에서도 비교는 된다 -->
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center">
                                <Hyperlink Command="{Binding OpenReleasesCommand}" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{loc:Tr 'GitHub releases'}" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="{Binding LatestReleaseText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding VersionCompareText}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding VersionCompareText, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                        <!-- 계약: 고른 버전을 받아 설치한다(낮은 버전 = 되돌리기). 설치본에서만 동작한다 -->
                        <DockPanel Margin="0,8,0,0">
                            <Button Content="{loc:Tr 'Install this version'}" DockPanel.Dock="Right" Padding="10,4" FontSize="11" Margin="6,0,0,0"
                                    Style="{StaticResource SettingsButton}" Command="{Binding InstallSelectedReleaseCommand}" />
                            <ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" Style="{StaticResource SettingsComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Shown only when extra accounts exist -->
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MulticcDetected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <CheckBox IsChecked="{Binding MulticcEnabled}" Style="{StaticResource SettingsCheckBox}"
                                      ToolTip="{loc:Tr 'Automatically detect and display all multicc profiles in the Claude tab.'}">
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="{loc:Tr 'Use multicc profiles'}" /><Run Text="  " /><Run Text="{Binding MulticcProfileCount, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                                </TextBlock>
                            </CheckBox>
                            <TextBlock Text="{Binding MulticcRestartMessage}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"
                                       Visibility="{Binding MulticcRestartMessage, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>
                <!-- Appearance -->
                <TabItem Header="{loc:Tr 'Display'}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding Palettes}" DockPanel.Dock="Right">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Cursor="Hand" Margin="6,0,0,0" FocusVisualStyle="{x:Null}" ToolTip="{Binding Name}"
                                                Command="{Binding DataContext.SelectPaletteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Name}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ring" Width="24" Height="24" CornerRadius="12" BorderThickness="2"
                                                            BorderBrush="Transparent" Background="Transparent">
                                                        <Border Width="16" Height="16" CornerRadius="8" Background="{Binding Swatch}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ring" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:Tr 'Theme'}" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                        <DockPanel>
                            <Button Content="English" DockPanel.Dock="Right" Padding="10,4" FontSize="11" Margin="4,0,0,0"
                                    Style="{StaticResource SettingsButton}" Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                            <Button Content="한국어" DockPanel.Dock="Right" Padding="10,4" FontSize="11"
                                    Style="{StaticResource SettingsButton}" Command="{Binding SetLanguageCommand}" CommandParameter="ko" />
                            <TextBlock Style="{StaticResource RowLabel}">
                                <Run Text="{loc:Tr 'Language'}" /><Run Text=" · " /><Run Text="{Binding LanguageLabel, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                </TabItem>
                <!-- 계약: 트레이 아이콘 — 기본 모양 4종(테마 색) + 사용자 아이콘 + 「+ 그리기」·「+ 불러오기」 칸. 고르면 트레이에 바로 반영된다 -->
                <!-- 계약: 그리기는 목록 대신 열리는 별도 화면이고, 저장하면 새 아이콘이 하나 더해진다(기존 것은 안 바뀐다) -->
                <TabItem Header="{loc:Tr 'Icon'}">
                    <StackPanel>
                        <StackPanel Visibility="{Binding IsIconEditorOpen, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}">
                            <TextBlock Text="{loc:Tr 'Tray icon'}" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding IconOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,6,6">
                                            <Button Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                    Command="{Binding DataContext.SelectTrayIconCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Style}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ring" Width="56" Padding="0,6,0,4" CornerRadius="8" BorderThickness="2"
                                                                BorderBrush="Transparent" Background="{DynamicResource SubtleOverlayBrush}">
                                                            <StackPanel>
                                                                <Grid Width="32" Height="32">
                                                                    <Image Source="{Binding Preview}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                                    <TextBlock Text="+" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               Visibility="{Binding IsAction, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"
                                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAction}" Value="True">
                                                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                                                <Setter TargetName="ring" Property="Background" Value="Transparent" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ring" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                                    Width="16" Height="16" Padding="0" FontSize="9" Cursor="Hand" ToolTip="{loc:Tr 'Delete this icon'}"
                                                    Style="{StaticResource SettingsButton}" CommandParameter="{Binding Style}"
                                                    Command="{Binding DataContext.DeleteTrayIconCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding IsCustom, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="{Binding IconMessage}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding IconMessage, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />

                        <!-- 계약: 16×16 칸 — 누르거나 끌면 고른 붓 색으로 칠한다(화면 코드 OnIconPixel*) -->
                        <StackPanel Visibility="{Binding IsIconEditorOpen, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{loc:Tr 'New icon'}" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                            <DockPanel>
                                <ItemsControl ItemsSource="{Binding IconPens}" DockPanel.Dock="Right" Margin="8,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Cursor="Hand" Margin="0,0,0,4" FocusVisualStyle="{x:Null}" ToolTip="{Binding Label}"
                                                    Command="{Binding DataContext.SelectIconPenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ring" Width="26" Height="26" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent">
                                                            <Grid Width="16" Height="16">
                                                                <Border CornerRadius="3" Background="{Binding Swatch}"
                                                                        BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}" />
                                                                <TextBlock Text="✕" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           Visibility="{Binding IsEraser, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Width="194" Height="194" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}"
                                        Background="{DynamicResource SubtleOverlayBrush}">
                                    <ItemsControl ItemsSource="{Binding IconPixels}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="16" Columns="16" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Fill}" BorderThickness="0,0,1,1" BorderBrush="#22808080"
                                                        MouseLeftButtonDown="OnIconPixelDown" MouseEnter="OnIconPixelEnter" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{loc:Tr 'Saving adds a new icon. Existing icons are not changed.'}" FontSize="10" TextWrapping="Wrap"
                                       Margin="0,6,0,0" Foreground="{DynamicResource TextFaintBrush}" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="JHJ" Padding="8,3" FontSize="11" Margin="0,0,4,4" ToolTip="{loc:Tr 'Start from'}"
                                        Style="{StaticResource SettingsButton}" Command="{Binding ResetIconCanvasCommand}" CommandParameter="j" />
                                <Button Content="{loc:Tr 'Blank tile'}" Padding="8,3" FontSize="11" Margin="0,0,4,4"
                                        Style="{StaticResource SettingsButton}" Command="{Binding ResetIconCanvasCommand}" CommandParameter="tile" />
                                <Button Content="{loc:Tr 'Clear'}" Padding="8,3" FontSize="11" Margin="0,0,4,4"
                                        Style="{StaticResource SettingsButton}" Command="{Binding ClearIconCanvasCommand}" />
                                <Button Content="{loc:Tr 'Cancel'}" Padding="8,3" FontSize="11" Margin="0,0,4,4"
                                        Style="{StaticResource SettingsButton}" Command="{Binding CancelIconEditorCommand}" />
                                <Button Content="{loc:Tr 'Save'}" Padding="8,3" FontSize="11" Margin="0,0,4,4"
                                        Style="{StaticResource SettingsButton}" Command="{Binding SaveIconDrawingCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
                </TabControl>
                <TextBlock Grid.Row="2" Text="{loc:Tr 'Accounts &amp; AI tools'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,6" />
                <TabControl Grid.Row="3" Style="{StaticResource SettingsTabControl}">
                <!-- Accounts -->
                <TabItem Header="{loc:Tr 'Accounts'}">
                    <!-- 계약: Agent 마다 하위 탭 하나 — 기본 계정 줄, 추가 계정 목록, 추가 입력이 그 Agent 것만 모여 있다. 로그인 진행·재시작 안내는 탭 아래 공용 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource GutterScrollViewer}">
                    <StackPanel>
                    <TabControl Style="{StaticResource SettingsSubTabControl}">
                    <TabItem Header="Claude">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6" ToolTip="{Binding ClaudeSourceText}">
                            <TextBlock Text="Claude" DockPanel.Dock="Left" Style="{StaticResource RowLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr 'Name · Type'}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFaintBrush}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ClaudeAccounts}" ItemTemplate="{StaticResource AccountRowTemplate}" />
                        <!-- 계약: 계정 추가 = 자리 하나 + 바로 연동(브라우저 로그인) → 실제 메일·토큰·중복 확인(SettingsViewModel.VerifyLink) -->
                        <DockPanel>
                            <Button Content="{loc:Tr 'Add account (browser sign-in)'}" DockPanel.Dock="Right" Padding="10,5" FontSize="11" Margin="6,0,0,0"
                                    Style="{StaticResource SettingsButton}" Command="{Binding AddAccountCommand}" />
                            <TextBlock Text="{loc:Tr 'The account you pick in the browser is added. Its email and token are checked afterwards.'}"
                                       FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                        </DockPanel>
                        <!-- 계약: 기본 폴더(~/.claude) 기록의 주인을 프로그램마다 정한다 — ClaudeProgramRouter. 지난 기록에도 적용된다 -->
                        <TextBlock Text="{loc:Tr 'Program links'}" Style="{StaticResource RowLabel}" FontWeight="SemiBold" Margin="0,14,0,2" />
                        <TextBlock Text="{loc:Tr 'Usage from each program on this PC is counted for the account you pick here. Past logs follow the change too.'}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,0,0,2" Foreground="{DynamicResource TextFaintBrush}" />
                        <!-- 계약: ClaudeCliSessions — 새 VS Code·CLI 세션은 그때의 로그인 계정을 따르고, 아래 표는 그 전 기록에만 쓰인다 -->
                        <TextBlock Text="{loc:Tr 'New VS Code and CLI sessions are counted for the account signed in on this PC at that time. The table below applies to older sessions.'}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource TextFaintBrush}" />
                        <ItemsControl ItemsSource="{Binding ProgramLinks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <ComboBox DockPanel.Dock="Right" Width="230" Style="{StaticResource SettingsComboBox}"
                                                  ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedAccount}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </TabItem>
                    <TabItem Header="Codex">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6" ToolTip="{Binding CodexSourceText}">
                            <TextBlock Text="Codex" DockPanel.Dock="Left" Style="{StaticResource RowLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr 'Name · Type'}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFaintBrush}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding CodexAccounts}" ItemTemplate="{StaticResource AccountRowTemplate}" />
                        <DockPanel>
                            <Button Content="{loc:Tr 'Add account (browser sign-in)'}" DockPanel.Dock="Right" Padding="10,5" FontSize="11" Margin="6,0,0,0"
                                    Style="{StaticResource SettingsButton}" Command="{Binding AddCodexAccountCommand}" />
                            <TextBlock Text="{loc:Tr 'The account you pick in the browser is added. Its email and token are checked afterwards.'}"
                                       FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                        </DockPanel>
                    </StackPanel>
                    </TabItem>
                    <!-- 계약: AI 도구마다 필요한 계정은 여기서 관리한다 — Copilot 은 GitHub 토큰, Gemini 는 gemini CLI 로그인 -->
                    <TabItem Header="Copilot">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr 'GitHub personal access token'}" Style="{StaticResource RowLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DockPanel ToolTip="{loc:Tr 'Personal access token'}">
                            <Button Content="{loc:Tr 'Clear'}"
                                    Command="{Binding ClearCopilotTokenCommand}" Padding="10,4" FontSize="11" Margin="4,0,0,0"
                                    IsEnabled="{Binding IsCopilotTokenBusy, Converter={x:Static local:BoolNegationConverter.Instance}}"
                                    Style="{StaticResource SettingsButton}" DockPanel.Dock="Right" />
                            <Button Content="{loc:Tr 'Save'}"
                                    Click="OnSaveCopilotTokenClick" Padding="10,4" FontSize="11" Margin="6,0,0,0"
                                    IsEnabled="{Binding IsCopilotTokenBusy, Converter={x:Static local:BoolNegationConverter.Instance}}"
                                    Style="{StaticResource SettingsButton}" DockPanel.Dock="Right" />
                            <Grid>
                                <PasswordBox x:Name="CopilotTokenBox" Height="26" VerticalContentAlignment="Center"
                                             Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource DividerBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             IsEnabled="{Binding IsCopilotTokenBusy, Converter={x:Static local:BoolNegationConverter.Instance}}" />
                                <TextBlock Text="********" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" Margin="8,0"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCopilotToken}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=CopilotTokenBox, Path=IsKeyboardFocused}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                        <TextBlock Text="{Binding CopilotTokenStatus}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,6,0,0"
                                   Visibility="{Binding CopilotTokenStatus, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                    </StackPanel>
                    </TabItem>
                    <TabItem Header="Gemini">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Gemini" Width="52" DockPanel.Dock="Left" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding GeminiAccountText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DockPanel>
                        <TextBlock Text="{loc:Tr 'Quota needs a Code Assist Standard/Enterprise seat. Personal Google sign-in was closed on 2026-06-18, so only token and cost history shows for it. Cost is an API-price estimate.'}"
                                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFaintBrush}" />
                    </StackPanel>
                    </TabItem>
                    </TabControl>
                        <TextBlock Text="{Binding AccountsMessage}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding AccountsMessage, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AccountsMessageIsSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- 계약: 로그인 CLI 가 뒤에서 도는 동안만 보인다 — 코드 칸은 브라우저가 코드를 보여 주는 로그인(Claude)일 때만 -->
                        <!-- 계약: 로그인 중 안내 — CLI 의 마지막 안내 줄 · 로그인 페이지 링크 · 코드가 무엇인지 -->
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding LoginInProgress, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                            <WrapPanel Margin="0,0,0,4" Visibility="{Binding LoginUrl, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                                <Button Content="{loc:Tr 'Open in browser'}" Padding="8,3" FontSize="11" Margin="0,0,4,4"
                                        Style="{StaticResource SettingsButton}" Command="{Binding OpenLoginPageCommand}" CommandParameter="default" />
                                <Button Content="{loc:Tr 'Login window'}" Padding="8,3" FontSize="11" Margin="0,0,4,4"
                                        Style="{StaticResource SettingsButton}" Command="{Binding OpenLoginPageCommand}" CommandParameter="dedicated"
                                        ToolTip="{loc:Tr 'Opens a separate Chrome window with no saved sign-in, so you can pick any account. It closes when linking finishes.'}" />
                                <Button Content="{loc:Tr 'Copy address'}" Padding="8,3" FontSize="11" Margin="0,0,4,4"
                                        Style="{StaticResource SettingsButton}" Command="{Binding OpenLoginPageCommand}" CommandParameter="copy" />
                            </WrapPanel>
                            <TextBlock Text="{Binding LoginOutput}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource TextFaintBrush}"
                                       Visibility="{Binding LoginOutput, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{loc:Tr 'Which code? After you click Authorize in the browser, claude.ai shows an Authentication Code — copy it and paste it below. If the browser finishes by itself, no code is needed.'}"
                                       FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding LoginAcceptsCode, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>
                        <DockPanel Margin="0,6,0,0" Visibility="{Binding LoginInProgress, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                            <Button Content="{loc:Tr 'Cancel'}" DockPanel.Dock="Right" Padding="10,5" FontSize="11" Margin="6,0,0,0"
                                    Style="{StaticResource SettingsButton}" Command="{Binding CancelLoginCommand}" />
                            <Button Content="{loc:Tr 'Apply code'}" DockPanel.Dock="Right" Padding="10,5" FontSize="11" Margin="6,0,0,0"
                                    Style="{StaticResource SettingsButton}" Command="{Binding SubmitLoginCodeCommand}"
                                    Visibility="{Binding LoginAcceptsCode, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                            <TextBox Text="{Binding LoginCodeInput, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4"
                                     VerticalContentAlignment="Center" ToolTip="{loc:Tr 'Paste the code the browser shows after signing in'}"
                                     Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource DividerBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     Visibility="{Binding LoginAcceptsCode, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                        </DockPanel>
                        <Button Content="{loc:Tr 'Restart app to apply'}" HorizontalAlignment="Left" Padding="10,5" FontSize="11" Margin="0,6,0,0"
                                Style="{StaticResource SettingsButton}" Command="{Binding RestartAppCommand}">
                            <Button.Visibility>
                                <Binding Path="AccountsRestartPending">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter />
                                    </Binding.Converter>
                                </Binding>
                            </Button.Visibility>
                        </Button>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{loc:Tr 'AI tools'}">
                <TabControl Style="{StaticResource SettingsSubTabControl}">
                <TabItem Header="Copilot">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding CopilotEnabled}" Style="{StaticResource SettingsCheckBox}" Margin="0,0,0,8"
                                  ToolTip="{loc:Tr 'Connect a GitHub personal access token to fetch usage data.'}">
                            <TextBlock Text="{loc:Tr 'Enable GitHub Copilot usage'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </CheckBox>
                        <TextBlock Text="{loc:Tr 'The token is managed in Accounts › Copilot.'}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFaintBrush}" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="Gemini">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding GeminiEnabled}" Style="{StaticResource SettingsCheckBox}" Margin="0,0,0,10"
                                  ToolTip="{loc:Tr 'Reads ~/.gemini: quota from the signed-in Code Assist seat, tokens and cost from session logs.'}">
                            <TextBlock Text="{loc:Tr 'Show Gemini CLI usage'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </CheckBox>
                        <TextBlock Text="{loc:Tr 'The sign-in is shown in Accounts › Gemini.'}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFaintBrush}" />
                    </StackPanel>
                </TabItem>
                </TabControl>
                </TabItem>
                </TabControl>
            </Grid>

            <!-- 계약: MIT 고지는 화면이 아니라 배포 꾸러미의 LICENSE 와 exe 의 Copyright 속성이 맡는다 — README 「라이선스」 -->
            <DockPanel Grid.Row="3" Margin="2,4,2,0">
                <TextBlock FontSize="11" DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Hyperlink NavigateUri="https://github.com/HyungJIn-kr-97" RequestNavigate="OnLinkNavigate" ToolTip="github.com/HyungJIn-kr-97"
                               Foreground="{DynamicResource AccentBrush}">GitHub</Hyperlink>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Version, StringFormat='v{0}', Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{loc:Tr 'Made by'}" /><Run Text=" HyungJin Ju (" /><Hyperlink NavigateUri="mailto:gudwls9730@gmail.com" RequestNavigate="OnLinkNavigate"
                               Foreground="{DynamicResource AccentBrush}">gudwls9730@gmail.com</Hyperlink><Run Text=")" />
                </TextBlock>
            </DockPanel>
        </Grid>
</UserControl>
