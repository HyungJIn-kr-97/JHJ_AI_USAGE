<UserControl x:Class="costats.App.Views.LinkModeMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:costats.App"
             xmlns:loc="clr-namespace:Jhj.Core.Wpf.Localization;assembly=Jhj.Core.Wpf">
    <!-- 계약: 「연동 ▾」 — 누르면 CLI · App · 웹 세 방식이 펼쳐지고, 고른 방식으로 GlassWidgetWindow.LinkAccount 를 부른다. DataContext 는 카드(ProviderPulseViewModel) -->
    <!-- 왜: 방식마다 로그인 주체가 다르다 — CLI 는 터미널 창, App 은 데스크톱 앱의 계정(로그인 없음), 웹은 앱이 연 브라우저 -->
    <UserControl.Resources>
        <ControlTemplate x:Key="LinkModeRow" TargetType="Button">
            <Border x:Name="row" CornerRadius="6" Padding="10,6" Background="Transparent">
                <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="RowDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="230" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle" Cursor="Hand" FocusVisualStyle="{x:Null}" VerticalAlignment="Center"
                      ToolTip="{loc:Tr 'Link an account to this slot — pick CLI, desktop app or browser.'}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=Menu, Converter={x:Static local:BoolNegationConverter.Instance}}">
            <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLinkBusy}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ToggleButton.Style>
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="pill" CornerRadius="4" Padding="8,2" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                            Background="{DynamicResource TabHoverBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Tr 'Link'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Margin="5,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <Popup x:Name="Menu" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="200">
                <StackPanel>
                    <Button Tag="cli" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="OnModeClick" Template="{StaticResource LinkModeRow}">
                        <StackPanel>
                            <TextBlock Text="CLI" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{loc:Tr 'Claude Code signs in from its own terminal window — the code goes there too.'}" Style="{StaticResource RowDetail}" />
                        </StackPanel>
                    </Button>
                    <!-- 계약: App 은 Claude 자리에만 — Codex 는 전용 앱 출처를 아직 읽지 않는다(ProviderPulseViewModel.CanLinkFromDesktopApp) -->
                    <Button Tag="app" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="OnModeClick" Template="{StaticResource LinkModeRow}"
                            Visibility="{Binding CanLinkFromDesktopApp, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr 'Desktop app'}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{loc:Tr 'Uses the account signed in to the Claude desktop app — no sign-in window, no token.'}" Style="{StaticResource RowDetail}" />
                        </StackPanel>
                    </Button>
                    <Button Tag="web" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="OnModeClick" Template="{StaticResource LinkModeRow}">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr 'Web'}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{loc:Tr 'This app opens the browser and takes the code here.'}" Style="{StaticResource RowDetail}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
