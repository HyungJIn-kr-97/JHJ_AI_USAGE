<UserControl x:Class="costats.App.Views.LinkModeMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:costats.App"
             xmlns:loc="clr-namespace:Jhj.Core.Wpf.Localization;assembly=Jhj.Core.Wpf">
    <!-- 계약: 「연동 ▾」 — 누르면 CLI · App · 웹 세 방식이 펼쳐지고, 고른 방식을 ModeChosen(cli · app · web)으로 알린다. 호스트가 자리를 정해 SettingsViewModel 에 넘긴다 -->
    <!-- 계약: Text(연동 · 다시 연동) · ShowDesktopApp(App 줄 — Claude 자리만) · IsBusy(연동 중 비활성) · Flat(설정 창의 네모 단추 모양) · State(줄 표지 — Opening 때 호스트가 LinkMenuStateFor 로 채운다) -->
    <!-- 왜: 방식마다 로그인 주체가 다르다 — CLI 는 터미널 창, App 은 데스크톱 앱의 계정(로그인 없음), 웹은 앱이 연 브라우저 -->
    <!-- 왜: 세 줄만 보면 무엇을 고를지 모른다 — 연동된 방식은 「연동됨」으로 잠그고, 아니면 한 줄에 「추천」을 붙이고, CLI 가 없으면 먼저 설치한다고 적는다 -->
    <UserControl.Resources>
        <ControlTemplate x:Key="LinkModeRow" TargetType="Button">
            <Border x:Name="row" CornerRadius="6" Padding="10,6" Background="Transparent">
                <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="row" Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="230" />
        </Style>
        <Style x:Key="RowNote" TargetType="TextBlock" BasedOn="{StaticResource RowDetail}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="RowBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="RowBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle" Cursor="Hand" FocusVisualStyle="{x:Null}" VerticalAlignment="Center"
                      ToolTip="{Binding ToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      IsEnabled="{Binding IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static local:BoolNegationConverter.Instance}}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=Menu, Converter={x:Static local:BoolNegationConverter.Instance}}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="pill" CornerRadius="4" Padding="8,2" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                            Background="{DynamicResource TabHoverBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="label" Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <Path x:Name="chevron" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Margin="5,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 왜: 설정 창의 이웃 단추(SettingsButton)와 같은 모양이어야 줄이 고르다 — 알약 대신 네모 -->
                        <DataTrigger Binding="{Binding Flat, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter TargetName="pill" Property="CornerRadius" Value="8" />
                            <Setter TargetName="pill" Property="Padding" Value="8,3" />
                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource SubtleOverlayBrush}" />
                            <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                            <Setter TargetName="label" Property="FontSize" Value="11" />
                            <Setter TargetName="label" Property="FontWeight" Value="Normal" />
                            <Setter TargetName="label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="chevron" Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <!-- 왜: 같은 단추가 줄마다 있다 — 펼친 것에 강조색 테와 눌린 바탕을 줘야 목록이 어느 줄 것인지 보인다 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                            <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="label" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="chevron" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="chevron" Property="Data" Value="M0,4 L4,0 L8,4" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <Popup x:Name="Menu" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="200">
                <StackPanel>
                    <Button x:Name="CliRow" Tag="cli" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="OnModeClick" Template="{StaticResource LinkModeRow}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="CLI" Style="{StaticResource RowTitle}" />
                                <Border x:Name="CliBadge" Style="{StaticResource RowBadge}">
                                    <TextBlock x:Name="CliBadgeText" Style="{StaticResource RowBadgeText}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{loc:Tr 'Claude Code signs in from its own terminal window — the code goes there too.'}" Style="{StaticResource RowDetail}" />
                            <TextBlock x:Name="CliNote" Style="{StaticResource RowNote}" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AppRow" Tag="app" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="OnModeClick" Template="{StaticResource LinkModeRow}"
                            Visibility="{Binding ShowDesktopApp, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{loc:Tr 'Desktop app'}" Style="{StaticResource RowTitle}" />
                                <Border x:Name="AppBadge" Style="{StaticResource RowBadge}">
                                    <TextBlock x:Name="AppBadgeText" Style="{StaticResource RowBadgeText}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{loc:Tr 'Uses the account signed in to the Claude desktop app — no sign-in window, no token.'}" Style="{StaticResource RowDetail}" />
                            <TextBlock x:Name="AppNote" Style="{StaticResource RowNote}" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="WebRow" Tag="web" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="OnModeClick" Template="{StaticResource LinkModeRow}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{loc:Tr 'Web'}" Style="{StaticResource RowTitle}" />
                                <Border x:Name="WebBadge" Style="{StaticResource RowBadge}">
                                    <TextBlock x:Name="WebBadgeText" Style="{StaticResource RowBadgeText}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{loc:Tr 'This app opens the browser and takes the code here.'}" Style="{StaticResource RowDetail}" />
                            <TextBlock x:Name="WebNote" Style="{StaticResource RowNote}" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
