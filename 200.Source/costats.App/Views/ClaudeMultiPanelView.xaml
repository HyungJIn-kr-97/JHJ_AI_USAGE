<UserControl x:Class="costats.App.Views.ClaudeMultiPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:costats.App"
             xmlns:views="clr-namespace:costats.App.Views"
        xmlns:loc="clr-namespace:costats.App.Localization">

    <UserControl.Resources>
        <!-- 색 브러시는 App 리소스(Themes/Bull.*.xaml)에서 온다 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Progress bar: 7px, fully rounded -->
        <Style x:Key="MetricProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3.5" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" CornerRadius="3.5" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}">
                                <Border.Width>
                                    <MultiBinding Converter="{x:Static local:ProgressWidthConverter.Instance}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Summary bar: health breakdown -->
        <Border Padding="10,5" Margin="0,0,0,0" CornerRadius="6" Background="{DynamicResource SubtleOverlayBrush}">
            <DockPanel>
                <!-- 계약: 「전체」에서는 머리글(다음 갱신 줄)이 숨는다 — 마지막 갱신과 다음 갱신을 여기서 한 줄로 보인다 -->
                <TextBlock DockPanel.Dock="Right" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextFaintBrush}">
                    <Run Text="{Binding UpdatedLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding NextRefreshShortText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding MulticcSummary}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           AutomationProperties.Name="Multicc profile summary" />
            </DockPanel>
        </Border>

        <!-- 함정: 안쪽 ScrollViewer 는 휠을 삼켜 바깥 본문이 안 굴러간다 — 스크롤은 창 본문 하나만 한다 -->
            <StackPanel>
                <ItemsControl ItemsSource="{Binding ClaudeProfiles}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,0"
                                        AutomationProperties.Name="{Binding DisplayName}">

                                <!-- Faded elegant separator (equal 10px above and below) -->
                                <Border Height="1" Margin="0,8,0,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="Transparent" Offset="0" />
                                            <GradientStop Color="#40D0CDE0" Offset="0.1" />
                                            <GradientStop Color="#40D0CDE0" Offset="0.9" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- HEADER: profile name + Claude-styled plan pill -->
                                <DockPanel Margin="0,0,0,6">
                                    <!-- Plan pill (Claude orange, right-aligned) -->
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,2"
                                            VerticalAlignment="Center"
                                            BorderBrush="#F97316" BorderThickness="1">
                                        <Border.Background>
                                            <SolidColorBrush Color="#F97316" Opacity="0.12" />
                                        </Border.Background>
                                        <TextBlock Text="{Binding PlanText}" FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PlanTextClaudeBrush}" />
                                    </Border>

                                    <!-- 계약: 요금제 왼쪽에 계정 상태 — 연동이 필요하면 「연동」 버튼 -->
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center"
                                            BorderThickness="1" BorderBrush="{Binding AccountStateBrush}"
                                            Visibility="{Binding AccountStateText, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                                        <TextBlock Text="{Binding AccountStateText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding AccountStateBrush}" />
                                    </Border>
                                    <Button DockPanel.Dock="Right" Content="{loc:Tr 'Link'}" Margin="0,0,6,0" VerticalAlignment="Center" Cursor="Hand"
                                            FocusVisualStyle="{x:Null}" Tag="{Binding ProviderId}" Click="OnLinkAccountClick"
                                            Template="{StaticResource LinkPillButton}"
                                            Visibility="{Binding NeedsLink, Converter={StaticResource BoolToVisibilityConverter}}" />


                                    <!-- 계약: 이름 바로 오른쪽에 유형 딱지 — 명칭·유형 편집은 설정 › 계정에서만 한다. 메일은 아래 줄 -->
                                    <DockPanel VerticalAlignment="Center" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                        <Border DockPanel.Dock="Left" CornerRadius="8" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center" BorderThickness="1"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                Visibility="{Binding HasAccountType, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding AccountType}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" />
                                        </Border>
                                    </DockPanel>
                                </DockPanel>
                                <!-- 왜: 비용 한 줄은 메일 줄 오른쪽에 둔다 — 머리글에 두면 배지·버튼과 폭을 다퉈 이름이 「…」로 사라졌다 -->
                                <DockPanel Margin="0,-4,0,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CompactCostText}" FontSize="10" Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding HasCompactCost, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding AccountEmail}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                                <!-- 계약: 이 카드에서 누른 「연동」의 진행 칸 — 브라우저 버튼·코드 칸·결과가 카드 바로 밑에 펼쳐진다 -->
                                <Border Visibility="{Binding IsLinking, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <views:LinkProgressView DataContext="{Binding DataContext.LinkContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Border>

                                <!-- 왜: 세션·주간을 좌우로 나란히 둔다 — 위아래로 쌓으면 계정 둘에 통계까지 한 화면에 들어가지 않는다 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <DockPanel>
                                            <TextBlock Text="{loc:Tr 'Session'}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" />
                                            <TextBlock Text="{Binding SessionPercentText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SessionTextBrush}" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <ProgressBar Value="{Binding SessionProgress}" Maximum="1" Foreground="{DynamicResource SessionBarBrush}" Style="{StaticResource MetricProgressBar}"
                                                     Margin="0,4,0,0" AutomationProperties.Name="{Binding SessionUsageLabel}" />
                                        <!-- 왜: 카드가 반 폭이라 「5일 2시간 후 초기화 · 10-13(화) 17:00」 이 한 줄에 안 들어간다 — 일시를 아랫줄로 내린다 -->
                                        <TextBlock Text="{Binding SessionResetText}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SessionResetAtText}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <DockPanel>
                                            <TextBlock Text="{loc:Tr 'Weekly'}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" />
                                            <TextBlock Text="{Binding WeekPercentText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource WeeklyTextBrush}" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <ProgressBar Value="{Binding WeekProgress}" Maximum="1" Foreground="{DynamicResource WeeklyBarBrush}" Style="{StaticResource MetricProgressBar}"
                                                     Margin="0,4,0,0" AutomationProperties.Name="{Binding WeekUsageLabel}" />
                                        <!-- 왜: 카드가 반 폭이라 「5일 2시간 후 초기화 · 10-13(화) 17:00」 이 한 줄에 안 들어간다 — 일시를 아랫줄로 내린다 -->
                                        <TextBlock Text="{Binding WeekResetText}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding WeekResetAtText}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                                <!-- OVERAGE / BALANCE FOOTER -->
                                <TextBlock Text="{Binding ExtraUsageLabel}" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"
                                           Visibility="{Binding HasExtraUsage, Converter={StaticResource BoolToVisibilityConverter}}" />

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- AGGREGATE TOTALS across all profiles -->
                <StackPanel Visibility="{Binding HasMulticcTotals, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,4,0,2">
                    <!-- Separator -->
                    <Border Height="1" Margin="0,6,0,10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="#60D0CDE0" Offset="0.1" />
                                <GradientStop Color="#60D0CDE0" Offset="0.9" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- 왜: 「오늘」 합계는 바로 아래 전체 통계의 「오늘」과 같은 값이라 뺐다 — 최근 7일만 남긴다 -->
                    <DockPanel>
                        <TextBlock Text="{loc:Tr 'All accounts, last 7 days:'}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding MulticcTotalWeekCost}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource CostMonthAccent}" />
                            <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding MulticcTotalWeekTokens}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{loc:Tr ' tokens'}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
    </StackPanel>
</UserControl>
