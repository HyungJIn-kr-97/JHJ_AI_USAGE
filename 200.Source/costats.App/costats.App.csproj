<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>costats.App</RootNamespace>
    <!-- 계약: 설치 파일(AI-Usage-Monitor_JHJ_&lt;버전&gt;_win-x64.exe)과 같은 이름이다 -->
    <!-- 함정: 바꾸면 업데이트·설치 관리자·배포 스크립트가 함께 걸린다 — 범위는 300.Docs\실행파일-이름-전환.md -->
    <AssemblyName>AI-Usage-Monitor_JHJ</AssemblyName>

    <!-- App metadata -->
    <Product>AI Usage Monitor</Product>
    <!-- 계약: 작업 관리자 「시작 앱」 · 속성 창의 파일 설명에 보이는 이름 -->
    <AssemblyTitle>AI 통합 사용량 모니터</AssemblyTitle>
    <Description>Usage statistics for Claude and Codex AI coding assistants</Description>
    <Company>jhj</Company>
    <Authors>jhj</Authors>
    <Copyright>Copyright (c) 2026 HyungJin Ju. Based on costats, Copyright (c) 2026 fmdz (MIT License)</Copyright>
    <RepositoryUrl>https://github.com/HyungJIn-kr-97/JHJ_AI_USAGE</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/HyungJIn-kr-97/JHJ_AI_USAGE</PackageProjectUrl>

    <!-- Publishing configuration -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- ReadyToRun disabled for smaller size (saves ~6MB, minimal startup impact for tray app) -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>

    <!-- Windows-specific -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Exclude unnecessary files from publish -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>

    <!-- Size optimization (trimming not supported with WPF) -->
    <!-- InvariantGlobalization reduces size but disables culture-specific formatting -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\\costats.Application\\costats.Application.csproj" />
    <ProjectReference Include="..\\costats.Infrastructure\\costats.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="NHotkey.Wpf" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Services\Updates\apply-update.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="apply-update.ps1" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <!-- Application icon -->
  <PropertyGroup>
    <ApplicationIcon>Resources\tray-icon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
