<Window x:Class="costats.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:costats.App"
        xmlns:loc="clr-namespace:costats.App.Localization"
        Title="Settings"
        Width="360"
        FontFamily="Pretendard Variable, Pretendard, Malgun Gothic, Segoe UI"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      CornerRadius="16"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Light color palette with WCAG AA contrast -->
        <!-- 색 브러시는 App 리소스(Themes/Bull.*.xaml)에서 온다 -->

        <!-- ComboBox Style -->
        <!-- 함정: 기본 ComboBox 템플릿은 배경이 밝은 색으로 고정이라 Background 만 바꿔서는 다크가 안 된다 — 템플릿을 통째로 갈아야 한다 -->
        <Style x:Key="SettingsComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="10,6" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" Background="{DynamicResource SubtleOverlayBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6">
                                            <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,7,26,7" VerticalAlignment="Center" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 왜: 기본 TabControl 은 밝은 바탕·입체 탭이라 테마와 어긋난다 — 머리글은 밑줄형, 본문은 Panel 색 카드로 다시 그린다 -->
        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Head" Padding="12,7" Margin="0,0,2,0" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Background="Transparent" CornerRadius="6,6,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Head" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Head" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTabControl" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                <TabPanel IsItemsHost="True" Margin="0,0,0,-1" />
                            </Border>
                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1,0,1,1" CornerRadius="0,0,10,10" Padding="12,12,12,12">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckBorder" Width="20" Height="20" CornerRadius="4"
                                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M3,7 L7,11 L13,3" Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="2"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="12" Height="10" Stretch="Uniform" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SubtleOverlayBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1"
            Background="{DynamicResource BgBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{loc:Tr 'Settings'}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                <Button Content="X" Click="OnCloseClick" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Width="28" Height="28" Padding="0"
                        Style="{StaticResource SettingsButton}" FontWeight="SemiBold" />
            </DockPanel>

            <!-- Divider -->
            <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16" />

            <!-- Settings Content: one tab per topic. Long explanations live in tooltips. -->
            <!-- 계약: MinHeight 는 가장 긴 탭(계정) 기준이다 — 탭을 바꿀 때 창 높이가 출렁이지 않게 한다 -->
            <TabControl Grid.Row="2" Style="{StaticResource SettingsTabControl}" MinHeight="300" Margin="0,0,0,10">
                <TabControl.Resources>
                    <Style x:Key="RowLabel" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </TabControl.Resources>

                <!-- Accounts -->
                <TabItem Header="{loc:Tr 'Accounts'}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4" ToolTip="{Binding ClaudeSourceText}">
                            <TextBlock Text="Claude" Width="52" DockPanel.Dock="Left" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding ClaudeAccountText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DockPanel>
                        <DockPanel ToolTip="{Binding CodexSourceText}">
                            <TextBlock Text="Codex" Width="52" DockPanel.Dock="Left" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding CodexAccountText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DockPanel>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,8" />

                        <!-- Usage-only Claude accounts -->
                        <TextBlock Text="{loc:Tr 'Extra Claude accounts (usage only)'}" FontSize="11" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <ItemsControl ItemsSource="{Binding ExtraAccounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button Content="{loc:Tr 'Remove'}" DockPanel.Dock="Right" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                                Style="{StaticResource SettingsButton}"
                                                Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{loc:Tr 'Sign in'}" DockPanel.Dock="Right" Padding="8,3" FontSize="11"
                                                Style="{StaticResource SettingsButton}"
                                                Command="{Binding DataContext.SignInAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <StackPanel VerticalAlignment="Center" ToolTip="{Binding ConfigDir}">
                                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding AccountText}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFaintBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel>
                            <Button Content="{loc:Tr 'Add account'}" DockPanel.Dock="Right" Padding="10,5" FontSize="11" Margin="6,0,0,0"
                                    Style="{StaticResource SettingsButton}" Command="{Binding AddAccountCommand}" />
                            <TextBox Text="{Binding NewAccountName, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4"
                                     VerticalContentAlignment="Center" ToolTip="{loc:Tr 'Email or a short name for the account'}"
                                     Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource DividerBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" />
                        </DockPanel>
                        <TextBlock Text="{Binding AccountsMessage}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding AccountsMessage, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                        <Button Content="{loc:Tr 'Restart app to apply'}" HorizontalAlignment="Left" Padding="10,5" FontSize="11" Margin="0,6,0,0"
                                Style="{StaticResource SettingsButton}" Command="{Binding RestartAppCommand}">
                            <Button.Visibility>
                                <Binding Path="AccountsRestartPending">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter />
                                    </Binding.Converter>
                                </Binding>
                            </Button.Visibility>
                        </Button>
                    </StackPanel>
                </TabItem>

                <!-- Appearance -->
                <TabItem Header="{loc:Tr 'Appearance'}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding Palettes}" DockPanel.Dock="Right">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Cursor="Hand" Margin="6,0,0,0" FocusVisualStyle="{x:Null}" ToolTip="{Binding Name}"
                                                Command="{Binding DataContext.SelectPaletteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Name}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ring" Width="24" Height="24" CornerRadius="12" BorderThickness="2"
                                                            BorderBrush="Transparent" Background="Transparent">
                                                        <Border Width="16" Height="16" CornerRadius="8" Background="{Binding Swatch}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ring" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:Tr 'Theme'}" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                        <DockPanel>
                            <Button Content="English" DockPanel.Dock="Right" Padding="10,4" FontSize="11" Margin="4,0,0,0"
                                    Style="{StaticResource SettingsButton}" Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                            <Button Content="한국어" DockPanel.Dock="Right" Padding="10,4" FontSize="11"
                                    Style="{StaticResource SettingsButton}" Command="{Binding SetLanguageCommand}" CommandParameter="ko" />
                            <TextBlock Style="{StaticResource RowLabel}">
                                <Run Text="{loc:Tr 'Language'}" /><Run Text=" · " /><Run Text="{Binding LanguageLabel, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                </TabItem>

                <!-- General -->
                <TabItem Header="{loc:Tr 'General'}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding StartAtLogin}" Style="{StaticResource SettingsCheckBox}" Margin="0,0,0,10"
                                  ToolTip="{loc:Tr 'Automatically launch AI Usage Monitor when Windows starts.'}">
                            <TextBlock Text="{loc:Tr 'Start at login'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </CheckBox>
                        <DockPanel ToolTip="{loc:Tr 'How often AI Usage Monitor polls for usage data in the background.'}">
                            <ComboBox ItemsSource="{Binding RefreshOptions}"
                                      SelectedItem="{Binding SelectedRefreshOption}"
                                      Style="{StaticResource SettingsComboBox}"
                                      DockPanel.Dock="Right" HorizontalAlignment="Right" Width="96">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{loc:Tr 'Refresh interval'}" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <Button Content="{loc:Tr 'Check for updates'}" DockPanel.Dock="Right" Padding="10,4" FontSize="11"
                                    Style="{StaticResource SettingsButton}" Command="{Binding CheckForUpdatesCommand}" />
                            <TextBlock Style="{StaticResource RowLabel}">
                                <Run Text="{loc:Tr 'Version'}" /><Run Text="{Binding Version, StringFormat=' {0}', Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Shown only when extra accounts exist -->
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MulticcDetected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <CheckBox IsChecked="{Binding MulticcEnabled}" Style="{StaticResource SettingsCheckBox}"
                                      ToolTip="{loc:Tr 'Automatically detect and display all multicc profiles in the Claude tab.'}">
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="{loc:Tr 'Use multicc profiles'}" /><Run Text="  " /><Run Text="{Binding MulticcProfileCount, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                                </TextBlock>
                            </CheckBox>
                            <TextBlock Text="{Binding MulticcRestartMessage}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"
                                       Visibility="{Binding MulticcRestartMessage, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- Copilot -->
                <TabItem Header="Copilot">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding CopilotEnabled}" Style="{StaticResource SettingsCheckBox}" Margin="0,0,0,8"
                                  ToolTip="{loc:Tr 'Connect a GitHub personal access token to fetch usage data.'}">
                            <TextBlock Text="{loc:Tr 'Enable GitHub Copilot usage'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </CheckBox>
                        <DockPanel ToolTip="{loc:Tr 'Personal access token'}">
                            <Button Content="{loc:Tr 'Clear'}"
                                    Command="{Binding ClearCopilotTokenCommand}" Padding="10,4" FontSize="11" Margin="4,0,0,0"
                                    IsEnabled="{Binding IsCopilotTokenBusy, Converter={x:Static local:BoolNegationConverter.Instance}}"
                                    Style="{StaticResource SettingsButton}" DockPanel.Dock="Right" />
                            <Button Content="{loc:Tr 'Save'}"
                                    Click="OnSaveCopilotTokenClick" Padding="10,4" FontSize="11" Margin="6,0,0,0"
                                    IsEnabled="{Binding IsCopilotTokenBusy, Converter={x:Static local:BoolNegationConverter.Instance}}"
                                    Style="{StaticResource SettingsButton}" DockPanel.Dock="Right" />
                            <Grid>
                                <PasswordBox x:Name="CopilotTokenBox" Height="26" VerticalContentAlignment="Center"
                                             Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource DividerBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             IsEnabled="{Binding IsCopilotTokenBusy, Converter={x:Static local:BoolNegationConverter.Instance}}" />
                                <TextBlock Text="********" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" Margin="8,0"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCopilotToken}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=CopilotTokenBox, Path=IsKeyboardFocused}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                        <TextBlock Text="{Binding CopilotTokenStatus}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,6,0,0"
                                   Visibility="{Binding CopilotTokenStatus, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                    </StackPanel>
                </TabItem>

                <!-- Gemini -->
                <TabItem Header="Gemini">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding GeminiEnabled}" Style="{StaticResource SettingsCheckBox}" Margin="0,0,0,10"
                                  ToolTip="{loc:Tr 'Reads ~/.gemini: quota from the signed-in Code Assist seat, tokens and cost from session logs.'}">
                            <TextBlock Text="{loc:Tr 'Show Gemini CLI usage'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </CheckBox>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Gemini" Width="52" DockPanel.Dock="Left" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding GeminiAccountText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DockPanel>
                        <TextBlock Text="{loc:Tr 'Quota needs a Code Assist Standard/Enterprise seat. Personal Google sign-in was closed on 2026-06-18, so only token and cost history shows for it. Cost is an API-price estimate.'}"
                                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFaintBrush}" />
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Footer: version · author · links on one line, attribution below -->
            <StackPanel Grid.Row="3" Margin="2,4,2,0">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Version, StringFormat='v{0}', Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{loc:Tr 'Made by'}" /><Run Text=" HyungJin Ju (" /><Hyperlink NavigateUri="mailto:gudwls9730@gmail.com" RequestNavigate="OnLinkNavigate"
                               Foreground="{DynamicResource AccentBrush}">gudwls9730@gmail.com</Hyperlink><Run Text=")" />
                </TextBlock>
                <DockPanel Margin="0,3,0,0">
                    <TextBlock FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Hyperlink NavigateUri="https://github.com/HyungJIn-kr-97" RequestNavigate="OnLinkNavigate" ToolTip="github.com/HyungJIn-kr-97"
                                   Foreground="{DynamicResource AccentBrush}">GitHub</Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{loc:Tr 'Based on costats by fmdz (MIT License)'}" FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFaintBrush}" />
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
